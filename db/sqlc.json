{
  "version": "2",
  "sql": [
    {
      "engine": "postgresql",
      "queries": "./sql/query.sql",
      "schema": "./sql/migrations",
      "gen": {
        "go": {
          "out": ".",
          "package": "db",
          "sql_package": "pgx/v5",
          "emit_pointers_for_null_types": true,
          "emit_json_tags": true,
          "overrides": [
            {
              "db_type": "text",
              "go_type": { "type": "string" }
            },
            {
              "column": "aircrafts.status",
              "go_type": { "type": "AircraftStatus" }
            },
            {
              "column": "flights.status",
              "go_type": { "type": "FlightStatus" }
            }
          ]
        }
      }
    }
  ]
}
